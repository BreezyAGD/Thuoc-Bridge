{
  "_comment": "Demo scenarios for the alert engine. Each lists what a synthetic label prints (fictional sample names and assumed ingredients, placeholders until the team verifies the real box), any typed US medicines, and the exact set of alert rule ids that must fire: no more, no fewer. Run with `npm run check:scenarios`. Replace the assumed ingredients with the real ones once each box has been read by a person.",
  "scenarios": [
    {
      "id": "1-paracetamol-duplication",
      "description": "Vietnamese paracetamol product + US hydrocodone/acetaminophen",
      "products": [
        { "brand": "Paracetamol 650", "ingredients": [{ "name": "Paracetamol", "strength": 650, "unit": "mg" }] }
      ],
      "us_meds": ["Norco"],
      "expect": ["apap-duplicate"]
    },
    {
      "id": "1b-paracetamol-plus-tylenol",
      "description": "Vietnamese effervescent paracetamol + US Tylenol",
      "products": [
        { "brand": "Paracetamol 500 sủi", "ingredients": [{ "name": "Paracetamol", "strength": 500, "unit": "mg" }] }
      ],
      "us_meds": ["Tylenol"],
      "expect": ["apap-duplicate"]
    },
    {
      "id": "2-ginkgo-warfarin",
      "description": "Ginkgo-containing circulation product + warfarin",
      "products": [
        {
          "brand": "Hoạt huyết dưỡng não",
          "ingredients": [
            { "name": "Cao đinh lăng", "strength": 150, "unit": "mg" },
            { "name": "Cao bạch quả", "strength": 5, "unit": "mg" }
          ]
        }
      ],
      "us_meds": ["warfarin"],
      "expect": ["ginkgo-warfarin", "unresolved"]
    },
    {
      "id": "2b-ginkgo-apixaban",
      "description": "Ginkgo-containing circulation product + apixaban",
      "products": [
        {
          "brand": "Hoạt huyết dưỡng não",
          "ingredients": [
            { "name": "Cao đinh lăng", "strength": 150, "unit": "mg" },
            { "name": "Cao bạch quả", "strength": 5, "unit": "mg" }
          ]
        }
      ],
      "us_meds": ["Eliquis"],
      "expect": ["ginkgo-doac", "unresolved"]
    },
    {
      "id": "3-cold-medicine-bp",
      "description": "Combination cold medicine + blood-pressure medicine + US Tylenol (hidden acetaminophen)",
      "products": [
        {
          "brand": "Viên cảm cúm",
          "ingredients": [
            { "name": "Paracetamol", "strength": 500, "unit": "mg" },
            { "name": "Phenylephrin HCl", "strength": 10, "unit": "mg" },
            { "name": "Clorpheniramin maleat", "strength": 2, "unit": "mg" }
          ]
        }
      ],
      "us_meds": ["amlodipine", "Tylenol"],
      "expect": ["apap-duplicate", "decongestant-antihypertensive"]
    },
    {
      "id": "3b-cold-medicine-ppa",
      "description": "Older cold formulation with phenylpropanolamine + lisinopril",
      "products": [
        {
          "brand": "Viên cảm cúm PPA",
          "ingredients": [
            { "name": "Paracetamol", "strength": 500, "unit": "mg" },
            { "name": "Phenylpropanolamin HCl", "strength": 25, "unit": "mg" },
            { "name": "Clorpheniramin maleat", "strength": 2, "unit": "mg" }
          ]
        }
      ],
      "us_meds": ["lisinopril"],
      "expect": ["ppa-present", "decongestant-antihypertensive"]
    },
    {
      "id": "4-otc-antibiotic",
      "description": "Amoxicillin bought over the counter",
      "products": [
        { "brand": "Amoxicilin 500", "ingredients": [{ "name": "Amoxicilin (dưới dạng Amoxicilin trihydrat)", "strength": 500, "unit": "mg" }] }
      ],
      "us_meds": [],
      "expect": ["otc-antibiotic", "beta-lactam-allergy"]
    },
    {
      "id": "5-herbal-no-ingredient-list",
      "description": "Herbal product whose photo shows no legible ingredient list",
      "products": [{ "brand": "Cao thảo dược", "ingredients": [] }],
      "us_meds": ["lisinopril"],
      "expect": ["unresolved"]
    },
    {
      "id": "negative-no-alert",
      "description": "Unrelated medicines: nothing should fire",
      "products": [
        { "brand": "Loratadin 10", "ingredients": [{ "name": "Loratadin", "strength": 10, "unit": "mg" }] }
      ],
      "us_meds": ["metformin"],
      "expect": []
    },
    {
      "id": "negative-same-product-combination",
      "description": "Ingredients formulated together in one product are not flagged against each other",
      "products": [
        {
          "brand": "Ibuprofen + Paracetamol",
          "ingredients": [
            { "name": "Ibuprofen", "strength": 200, "unit": "mg" },
            { "name": "Paracetamol", "strength": 325, "unit": "mg" }
          ]
        }
      ],
      "us_meds": [],
      "expect": []
    },
    {
      "id": "extra-nsaid-warfarin-steroid",
      "description": "OTC diclofenac + OTC dexamethasone + warfarin",
      "products": [
        { "brand": "Diclofenac 50", "ingredients": [{ "name": "Diclofenac natri", "strength": 50, "unit": "mg" }] },
        { "brand": "Dexamethason 0,5", "ingredients": [{ "name": "Dexamethason", "strength": 0.5, "unit": "mg" }] }
      ],
      "us_meds": ["warfarin"],
      "expect": ["nsaid-anticoagulant", "nsaid-corticosteroid", "systemic-corticosteroid"]
    }
  ]
}
