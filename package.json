{
  "name": "thuoc-bridge",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "extract": "tsx --env-file-if-exists=.env.local scripts/extract-one.ts",
    "check:normalize": "tsx scripts/normalize-check.ts",
    "rules:refresh": "tsx scripts/rules-refresh.ts",
    "check:scenarios": "tsx scripts/scenarios-check.ts",
    "eval": "tsx --env-file-if-exists=.env.local eval/run.ts",
    "demo:build": "tsx scripts/demo-build.ts",
    "check:demo": "tsx scripts/demo-check.ts",
    "check:eval": "tsx scripts/eval-check.ts",
    "check:release": "tsx scripts/release-check.ts",
    "check:golden": "tsx scripts/golden-check.ts",
    "check:offline-release": "tsx scripts/offline-release-check.ts",
    "check:all": "npm run typecheck && npm run lint && npm run check:normalize && npm run check:scenarios && npm run check:demo && npm run check:eval && npm run check:readiness && npm run build && npm run check:offline-release",
    "check:browser": "playwright test",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare deploy",
    "cf:dry-run": "wrangler deploy --dry-run",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "check:readiness": "tsx scripts/readiness-check.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.17",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "sharp": "^0.35.5",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "wrangler": "^4.148.0"
  }
}
