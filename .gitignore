# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# keep the env template
!.env.example

# local tool config
.claude/

# Local evaluation photos require explicit privacy review before publication.
/eval/photos/*
!/eval/photos/.gitkeep

# Browser regression artifacts (synthetic fixtures only)
/playwright-report/
/test-results/

# Cloudflare build output, local runtime state, and secrets
.open-next/
.wrangler/
.dev.vars
.dev.vars.*
!.dev.vars.example
cloudflare-env.d.ts

# Design-skill working files (local)
/.taste-skill/
